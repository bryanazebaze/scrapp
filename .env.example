# Copy to .env and adjust. All values have safe defaults for local dev.
DATABASE_URL=postgresql://immo_user:1234@localhost/immo_db
API_HOST=127.0.0.1
API_PORT=8000
# Scraper politeness: jittered delay range (seconds) between requests
SCRAPER_DELAY_MIN=2.0
SCRAPER_DELAY_MAX=5.0
# Optional outbound proxy for scrapers
HTTP_PROXY=
HTTPS_PROXY=
# CORS: comma-separated origins allowed to call the API (Flutter web etc.)
CORS_ORIGINS=*
# AI / Qwen — required for natural-language search + translation scripts.
# Leave blank to disable AI features.
QWEN_API_KEY=
QWEN_MODEL=qwen3.6-flash
QWEN_BASE_URL=https://ws-711m66u5kgmuf9cg.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Log level: DEBUG|INFO|WARNING|ERROR
LOG_LEVEL=INFO